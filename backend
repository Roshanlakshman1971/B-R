#!/usr/bin/env python3
"""Small standard-library API for the B&R Events inquiry form."""

import csv
from datetime import date, datetime, timezone
from email.message import EmailMessage
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import os
from pathlib import Path
import re
import smtplib
import sqlite3
import ssl
import sys
from urllib.parse import parse_qs, urlparse

ROOT = Path(__file__).resolve().parent
DB_PATH = ROOT / "data" / "inquiries.sqlite3"
EXPORT_PATH = ROOT / "data" / "inquiries_export.csv"
INQUIRY_EMAIL = "roshanlakshman1971@gmail.com"
ADMIN_EXPORT_TOKEN = os.environ.get("ADMIN_EXPORT_TOKEN", "BR_EVENTS_ADMIN_SECRET_2026").strip()
MAX_REQUEST_BYTES = 16 * 1024


def initialize_database():
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    with sqlite3.connect(DB_PATH) as connection:
        connection.execute(
            """
            CREATE TABLE IF NOT EXISTS inquiries (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                full_name TEXT NOT NULL,
                phone_number TEXT NOT NULL,
                email_address TEXT NOT NULL,
                event_type TEXT NOT NULL,
                event_date TEXT NOT NULL,
                guest_count TEXT NOT NULL,
                venue_location TEXT NOT NULL,
                requirements TEXT NOT NULL,
                created_at TEXT NOT NULL
            )
            """
        )
    export_inquiries_csv()


def fetch_inquiries():
    with sqlite3.connect(DB_PATH) as connection:
        return connection.execute(
            """
            SELECT
                id,
                full_name,
                phone_number,
                email_address,
                event_type,
                event_date,
                guest_count,
                venue_location,
                requirements,
                created_at
            FROM inquiries
            ORDER BY created_at DESC
            """
        ).fetchall()


def export_inquiries_csv():
    rows = fetch_inquiries()
    headers = [
        "id",
        "full_name",
        "phone_number",
        "email_address",
        "event_type",
        "event_date",
        "guest_count",
        "venue_location",
        "requirements",
        "created_at",
    ]
    with EXPORT_PATH.open("w", newline="", encoding="utf-8") as csv_file:
        writer = csv.writer(csv_file)
        writer.writerow(headers)
        writer.writerows(rows)
    return EXPORT_PATH


def validate_inquiry(payload):
    if not isinstance(payload, dict):
        raise ValueError("Please submit a valid inquiry form.")

    fields = {
        "full_name": (160, True),
        "phone_number": (40, True),
        "email_address": (254, True),
        "event_type": (100, True),
        "event_date": (10, True),
        "guest_count": (40, False),
        "venue_location": (200, False),
        "requirements": (4000, False),
    }
    inquiry = {}
    for name, (limit, required) in fields.items():
        value = payload.get(name, "")
        if not isinstance(value, str):
            raise ValueError("Please check the submitted form values.")
        value = value.strip()
        if required and not value:
            raise ValueError("Please complete all required fields.")
        if len(value) > limit:
            raise ValueError(f"{name.replace('_', ' ').capitalize()} is too long.")
        inquiry[name] = value

    if not re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", inquiry["email_address"]):
        raise ValueError("Please enter a valid email address.")
    if not re.fullmatch(r"[+()\d.\-\s]{7,40}", inquiry["phone_number"]):
        raise ValueError("Please enter a valid phone number.")
    try:
        event_date = date.fromisoformat(inquiry["event_date"])
    except ValueError as error:
        raise ValueError("Please enter a valid event date.") from error
    if event_date < date.today():
        raise ValueError("The event date cannot be in the past.")

    return inquiry


def save_inquiry(inquiry):
    with sqlite3.connect(DB_PATH) as connection:
        cursor = connection.execute(
            """
            INSERT INTO inquiries (
                full_name, phone_number, email_address, event_type, event_date,
                guest_count, venue_location, requirements, created_at
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (
                inquiry["full_name"],
                inquiry["phone_number"],
                inquiry["email_address"],
                inquiry["event_type"],
                inquiry["event_date"],
                inquiry["guest_count"],
                inquiry["venue_location"],
                inquiry["requirements"],
                datetime.now(timezone.utc).isoformat(timespec="seconds"),
            ),
        )
        return cursor.lastrowid


def send_inquiry_email(inquiry):
    smtp_host = os.environ.get("SMTP_HOST", "").strip()
    smtp_username = os.environ.get("SMTP_USERNAME", "").strip()
    smtp_password = os.environ.get("SMTP_PASSWORD", "")
    missing_settings = [
        name
        for name, value in (
            ("SMTP_HOST", smtp_host),
            ("SMTP_USERNAME", smtp_username),
            ("SMTP_PASSWORD", smtp_password),
        )
        if not value
    ]
    if missing_settings:
        raise RuntimeError("Missing SMTP settings: " + ", ".join(missing_settings))

    try:
        smtp_port = int(os.environ.get("SMTP_PORT", "587"))
    except ValueError as error:
        raise RuntimeError("SMTP_PORT must be a number.") from error

    message = EmailMessage()
    message["Subject"] = "New B&R Events website inquiry"
    message["From"] = os.environ.get("SMTP_FROM_EMAIL", smtp_username)
    message["To"] = INQUIRY_EMAIL
    message["Reply-To"] = inquiry["email_address"]
    message.set_content(
        "A new inquiry was submitted on the B&R Events website.\n\n"
        f"Name: {inquiry['full_name']}\n"
        f"Phone: {inquiry['phone_number']}\n"
        f"Email: {inquiry['email_address']}\n"
        f"Event type: {inquiry['event_type']}\n"
        f"Event date: {inquiry['event_date']}\n"
        f"Guest count: {inquiry['guest_count']}\n"
        f"Venue / area: {inquiry['venue_location']}\n"
        f"Requirements: {inquiry['requirements']}\n"
    )

    use_ssl = os.environ.get("SMTP_USE_SSL", "false").lower() == "true"
    if use_ssl:
        smtp_client = smtplib.SMTP_SSL(
            smtp_host,
            smtp_port,
            timeout=15,
            context=ssl.create_default_context(),
        )
    else:
        smtp_client = smtplib.SMTP(smtp_host, smtp_port, timeout=15)

    with smtp_client as server:
        if not use_ssl:
            server.starttls(context=ssl.create_default_context())
        server.login(smtp_username, smtp_password)
        server.send_message(message)


class RequestHandler(BaseHTTPRequestHandler):
    def send_json(self, status, payload):
        body = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def admin_token_matches(self):
        header_token = self.headers.get("X-Admin-Token", "").strip()
        if header_token:
            return header_token == ADMIN_EXPORT_TOKEN

        query = parse_qs(urlparse(self.path).query)
        url_token = query.get("token", [""])[0].strip()
        return url_token == ADMIN_EXPORT_TOKEN

    def do_GET(self):
        request_path = urlparse(self.path).path

        if request_path.startswith("/api/inquiries/export"):
            if not self.admin_token_matches():
                self.send_json(403, {"error": "Forbidden. This export is restricted to the site admin."})
                return

            try:
                export_path = export_inquiries_csv()
                body = export_path.read_bytes()
            except (OSError, sqlite3.Error):
                self.send_json(500, {"error": "The inquiry export could not be generated."})
                return

            self.send_response(200)
            self.send_header("Content-Type", "application/vnd.ms-excel; charset=utf-8")
            self.send_header("Content-Disposition", 'attachment; filename="inquiries_export.csv"')
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return

        if request_path not in ("/", "/test2.html"):
            self.send_json(404, {"error": "Not found."})
            return

        page = ROOT / "test2.html"
        try:
            body = page.read_text(encoding="utf-8")
        except OSError:
            self.send_json(404, {"error": "The event page could not be found."})
            return

        if self.admin_token_matches():
            body = body.replace(
                "<!-- EXPORT_BUTTON_PLACEHOLDER -->",
                """
                <button class=\"w-full py-space-md px-space-lg border border-primary text-primary bg-surface-container-lowest hover:bg-primary hover:text-on-primary font-title-lg text-title-lg rounded-lg transition-all duration-300 flex items-center justify-center gap-space-sm mt-space-xs\" id=\"exportInquiriesBtn\" type=\"button\">\n<span class=\"material-symbols-outlined\">download</span>\n<span class=\"\">Export to Excel</span>\n</button>\n""",
            )
        else:
            body = body.replace("<!-- EXPORT_BUTTON_PLACEHOLDER -->", "")

        body_bytes = body.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body_bytes)))
        self.end_headers()
        self.wfile.write(body_bytes)

    def do_POST(self):
        if self.path != "/api/inquiries":
            self.send_json(404, {"error": "Not found."})
            return

        try:
            content_length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            self.send_json(400, {"error": "Invalid request size."})
            return
        if content_length < 1 or content_length > MAX_REQUEST_BYTES:
            self.send_json(413, {"error": "The submitted inquiry is too large."})
            return

        try:
            payload = json.loads(self.rfile.read(content_length))
            inquiry = validate_inquiry(payload)
        except (json.JSONDecodeError, UnicodeDecodeError):
            self.send_json(400, {"error": "Please submit valid JSON."})
            return
        except ValueError as error:
            self.send_json(400, {"error": str(error)})
            return

        try:
            inquiry_id = save_inquiry(inquiry)
            export_inquiries_csv()
        except sqlite3.Error:
            self.send_json(500, {"error": "We could not save your inquiry. Please try again."})
            return

        email_warning = None
        try:
            send_inquiry_email(inquiry)
        except (OSError, RuntimeError, smtplib.SMTPException, ValueError) as error:
            print(
                f"Inquiry {inquiry_id} was saved, but its email notification failed: {error}",
                file=sys.stderr,
            )
            email_warning = (
                "Your inquiry was saved, but its email notification could not be sent. "
                "Please contact us directly while we resolve the email settings."
            )

        self.send_json(
            201,
            {
                "message": "Your inquiry has been received.",
                "id": inquiry_id,
                "email_warning": email_warning,
            },
        )


def main():
    initialize_database()
    server = ThreadingHTTPServer(("127.0.0.1", 8000), RequestHandler)
    print("B&R Events is running at http://127.0.0.1:8000")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nServer stopped.")
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
